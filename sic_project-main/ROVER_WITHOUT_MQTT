// ==============================================================================
// WEB SERVER HANDLERS
// ==============================================================================
void handleRoot() {
  server.send(200, "text/html", index_html);
}

void handleCommand() {
  if (server.hasArg("type") && server.hasArg("val")) {
    String type = server.arg("type");
    String val = server.arg("val");

    if (type == "MODE") {
      if (val == "MANUAL") { currentState = STATE_MANUAL; strcpy(currentManualCmd, "STOP"); stopMotors(); }
      else if (val == "AUTO") { currentState = STATE_AUTO; updateAlertStatus("All Clear"); }
    } 
    else if (type == "MOVE" && currentState == STATE_MANUAL) {
      val.toCharArray(currentManualCmd, 15);
      lastCmdTime = millis(); // Reset safety timeout
    }
    server.send(200, "text/plain", "OK");
  } else {
    server.send(400, "text/plain", "Bad Request");
  }
}

void handleStatus() {
  char json[128];
  const char* modeStr = (currentState == STATE_AUTO) ? "AUTO" : "MANUAL";
  snprintf(json, sizeof(json), "{\"mode\":\"%s\", \"alert\":\"%s\", \"distance\":%.1f}", modeStr, currentAlert, frontDist);
  server.send(200, "application/json", json);
}

// ==============================================================================
// MAIN SETUP & LOOP
// ==============================================================================
void setup() {
  Serial.begin(115200);

  setupAP();

  // Setup Web Server Endpoints
  server.on("/", HTTP_GET, handleRoot);
  server.on("/cmd", HTTP_GET, handleCommand);
  server.on("/status", HTTP_GET, handleStatus);
  server.begin();
  Serial.println("HTTP Server Started.");

  pinMode(MOTOR_L_PWM, OUTPUT); pinMode(MOTOR_L_IN1, OUTPUT); pinMode(MOTOR_L_IN2, OUTPUT);
  pinMode(MOTOR_R_PWM, OUTPUT); pinMode(MOTOR_R_IN3, OUTPUT); pinMode(MOTOR_R_IN4, OUTPUT);
  pinMode(IR_LEFT_PIN, INPUT);  pinMode(IR_RIGHT_PIN, INPUT);
  pinMode(ULTRA_F_TRIG, OUTPUT); pinMode(ULTRA_F_ECHO, INPUT);
  pinMode(ULTRA_R_TRIG, OUTPUT); pinMode(ULTRA_R_ECHO, INPUT);
  
  pinMode(GAS_SENSOR_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
}

void loop() {
  server.handleClient(); // Process incoming HTTP web requests

  // FAILSAFE: Stop if phone disconnects from the Wi-Fi network
  if (WiFi.softAPgetStationNum() == 0) {
    stopMotors();
    strcpy(currentManualCmd, "STOP");
  }

  // --- SENSOR POLLING ---
  if (millis() - lastSensorTime >= SENSOR_INTERVAL) {
    frontDist = getDistance(ULTRA_F_TRIG, ULTRA_F_ECHO);
    delay(10); 
    rearDist = getDistance(ULTRA_R_TRIG, ULTRA_R_ECHO);
    lastSensorTime = millis();
    
    // Evaluate Front Obstacles
    if (frontDist > 0 && frontDist <= STOP_DISTANCE) {
      if (!obstacleAheadFlag) { obstacleAheadFlag = true; updateAlertStatus("Obstacle Ahead"); }
    } else if (obstacleAheadFlag) {
      obstacleAheadFlag = false; updateAlertStatus("All Clear");
    }

    // Evaluate Rear Obstacles
    if (strcmp(currentManualCmd, "REVERSE") == 0 && currentState == STATE_MANUAL) {
      if (rearDist > 0 && rearDist <= STOP_DISTANCE) {
        if (!objectBehindFlag) { objectBehindFlag = true; updateAlertStatus("Object Behind"); }
      } else if (objectBehindFlag) {
        objectBehindFlag = false; updateAlertStatus("All Clear");
      }
    }
    
    // Evaluate Gas Detection
    int gasState = digitalRead(GAS_SENSOR_PIN); 
    if (gasState == LOW) { 
      if (!gasAlertFlag) {
        gasAlertFlag = true; digitalWrite(BUZZER_PIN, HIGH); updateAlertStatus("GAS LEAK DETECTED");
      }
    } else if (gasAlertFlag) {
      gasAlertFlag = false; digitalWrite(BUZZER_PIN, LOW); updateAlertStatus("All Clear");
    }
  }

  // --- MOTOR EXECUTION LOGIC ---
  if (currentState == STATE_AUTO) {
    if (obstacleAheadFlag || gasAlertFlag || WiFi.softAPgetStationNum() == 0) {
      stopMotors();
    } else {
      runLineFollowing();
    }
  } 
  else if (currentState == STATE_MANUAL) {
    // FAILSAFE: Stop if web interface crashes or drops button release
    if (millis() - lastCmdTime > 1000 && strcmp(currentManualCmd, "STOP") != 0) {
      strcpy(currentManualCmd, "STOP");
      stopMotors();
    }
    else if (strcmp(currentManualCmd, "FORWARD") == 0 && obstacleAheadFlag) stopMotors(); 
    else if (strcmp(currentManualCmd, "REVERSE") == 0 && objectBehindFlag) stopMotors(); 
    else if (gasAlertFlag) stopMotors(); 
    else {
      if (strcmp(currentManualCmd, "FORWARD") == 0) driveMotors(200, 200);
      else if (strcmp(currentManualCmd, "REVERSE") == 0) driveMotors(-200, -200);
      else if (strcmp(currentManualCmd, "LEFT") == 0) driveMotors(-150, 150);
      else if (strcmp(currentManualCmd, "RIGHT") == 0) driveMotors(150, -150);
      else stopMotors();
    }
  }
}

// ==============================================================================
// HELPER FUNCTIONS
// ==============================================================================
void updateAlertStatus(const char* alert) {
  strncpy(currentAlert, alert, sizeof(currentAlert) - 1);
  currentAlert[sizeof(currentAlert) - 1] = '\0';
}

float getDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW); delayMicroseconds(2);
  digitalWrite(trigPin, HIGH); delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH, 20000); 
  if (duration == 0) return 999.0;
  return (duration * 0.0343) / 2;
}

void runLineFollowing() {
  int leftIR = digitalRead(IR_LEFT_PIN);
  int rightIR = digitalRead(IR_RIGHT_PIN);
  if (leftIR == 0 && rightIR == 0) driveMotors(180, 180);
  else if (leftIR == 1 && rightIR == 0) driveMotors(60, 180);
  else if (leftIR == 0 && rightIR == 1) driveMotors(180, 60);
  else stopMotors();
}

void driveMotors(int leftSpeed, int rightSpeed) {
  digitalWrite(MOTOR_L_IN1, leftSpeed >= 0 ? HIGH : LOW);
  digitalWrite(MOTOR_L_IN2, leftSpeed >= 0 ? LOW : HIGH);
  digitalWrite(MOTOR_R_IN3, rightSpeed >= 0 ? HIGH : LOW);
  digitalWrite(MOTOR_R_IN4, rightSpeed >= 0 ? LOW : HIGH);
  analogWrite(MOTOR_L_PWM, abs(leftSpeed));
  analogWrite(MOTOR_R_PWM, abs(rightSpeed));
}

void stopMotors() {
  analogWrite(MOTOR_L_PWM, 0); 
  analogWrite(MOTOR_R_PWM, 0);
}

void setupAP() {
  Serial.println("Configuring Access Point...");
  WiFi.softAP(ap_ssid, ap_password);
  IPAddress IP = WiFi.softAPIP();
  Serial.print("AP IP address: ");
  Serial.println(IP);
}
